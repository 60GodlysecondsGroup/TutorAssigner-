# Copia este archivo a `.env` (que está en .gitignore). Valores de DESARROLLO, no secretos.
# Producción: las variables se inyectan desde la plataforma de despliegue, nunca en la imagen.

# ── PostgreSQL (servicio db) ────────────────────────────────────────────────
POSTGRES_USER=tutorias
POSTGRES_PASSWORD=tutorias
POSTGRES_DB=tutorias

# ── API y migraciones (los servicios usan el host `db` de la red de Compose) ──
DATABASE_URL=postgres://tutorias:tutorias@db:5432/tutorias
DATABASE_URL_TEST=postgres://tutorias:tutorias@db:5432/tutorias_test
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Sesión: en producción JWT_SECRET es obligatorio (≥ 32 caracteres) y COOKIE_SECURE=true.
JWT_SECRET=dev-only-jwt-secret-cambialo-en-produccion-0001
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
BCRYPT_COST=12
LOGIN_RATE_LIMIT_MAX=10

# ── Seeds (servicio migrate) ────────────────────────────────────────────────
ADMIN_EMAIL=coordinador@tutorias.local
ADMIN_PASSWORD=coordinador-dev-123
ADMIN_NOMBRE=Coordinación de Tutorías
SEED_DEMO=true

# ── Frontend (VITE_* termina en el bundle público: nunca secretos) ─────────
VITE_API_MOCKS=false
VITE_API_PROXY_TARGET=http://api:3000

# ── Host ────────────────────────────────────────────────────────────────────
DB_HOST_PORT=5432
# Windows/macOS: si la recarga en caliente no detecta cambios, usa true.
WATCH_POLLING=false
# Linux: UID/GID de tu usuario para que los archivos generados no queden a nombre de root.
HOST_UID=1000
HOST_GID=1000
